# 全件評価の固定条件（評価計画 v2 §7）。wrapper はこの file を shell として評価せず、
# KEY=VALUE の行として読む。内容の sha256 は評価の条件（fingerprint）に入るので、
# 評価の途中で変えると再開を拒否する（条件を変えるときは別の評価として始める）。
#
# wrapper が使う key（runner には渡さない）
IMAGE=ghidra-docker-env:latest
CONTAINER_MEMORY=110g
# docker stop の猶予（秒）。runner の停止の確認（最大 60 秒）より長くする。
STOP_GRACE_SECONDS=120
#
# runner に渡す key（それ以外は runner の既定。FT_* も既定で、config identity に入る）
PARALLEL_JOBS=30
EQBENCH_RESOURCE_ADMISSION=0
EQBENCH_DEBUG=0
EQBENCH_IDENTICAL_FAST_PATH=1
SKIP_COMPLETED_RESULTS=1
ERROR_ONLY_RERUN=0
PAIR_PROCESS_TIMEOUT=600s
NEQ_RUN_SCOPE=FULL_NEQ
NEQ_BUILD_POLICY=REUSE_OR_COMPILE
EQBENCH_RUN_SCOPE=FULL_EQBENCH
EQBENCH_BUILD_POLICY=PREBUILT_ONLY
