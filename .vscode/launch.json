{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug function_tracer_pcode - equiv EqBench pair",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.function_tracer_pcode.main",
            "args": [
                "--equiv",
                "${workspaceFolder}/targets/EqBench/benchmarks/REVE/barthe2big/Eq/source/new-arm64-clang-O0",
                "${workspaceFolder}/targets/EqBench/benchmarks/REVE/barthe2big/Eq/source/new-mips64-clang-O1",
                "-f",
                "f",
                "--retry-with-int",
                "-d",
                // "-v"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}