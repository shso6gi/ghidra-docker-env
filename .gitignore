# Python
__pycache__/
*.pyc
*.pytest_cache/
*.egg-info/

# Host runtime caches (see README "Host PyGhidra Environment")
.venv/
.venv-pyghidra/
.local-jdk/
.local-jdk.bak-*/
.local-ghidra/
.local-ghidra-extract/

# Generated run outputs
logs/
tmp/
output/
*.smt*
hs_err_pid*.log

# Per-run signing keys and process-authority checkpoints written by the EqBench runners
**/.process-authority/
**/.process-authority-keys/
**/.phase8-execution-authority/
artifacts/**/*.key

# Target binaries: the EqBench tree is not git-managed; compiled objects anywhere under targets/ are rebuilt
targets/EqBench/
targets/**/*-x86_64-gcc-O*
targets/**/*-x86_64-clang-O*
targets/**/*-arm64-gcc-O*
targets/**/*-arm64-clang-O*
targets/**/*-mips64-gcc-O*
targets/**/*-mips64-clang-O*
targets/**/*.compile.log
